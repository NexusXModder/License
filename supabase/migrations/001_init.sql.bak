-- =====================================================================
-- Nexus License System — Migration 001: Initial schema + RLS
-- Run in: Supabase Dashboard → SQL Editor → New query → Run
-- Non-destructive: only CREATE statements. Safe to review before running.
-- =====================================================================

begin;

-- ---------------------------------------------------------------------
-- Helper trigger: keep updated_at fresh
-- ---------------------------------------------------------------------
create or replace function [public.nexus](https://public.nexus)_set_updated_at()
returns trigger
language plpgsql
set search_path = ''
as $$
begin
  [new.updated](https://new.updated)_at := now();
  return new;
end;
$$;

-- ---------------------------------------------------------------------
-- admin_users: server-controlled admin allowlist
-- (NOT user_metadata — users cannot edit this table)
-- ---------------------------------------------------------------------
create table if not exists [public.admin](https://public.admin)_users (
  user_id    uuid primary key references [auth.users](https://auth.users)(id) on delete cascade,
  role       text not null default 'admin' check (role in ('owner', 'admin')),
  created_at timestamptz not null default now(),
  created_by uuid null
);

-- ---------------------------------------------------------------------
-- client_apps: each website/project that uses Nexus
-- client_id is PUBLIC (not a secret). secret_hash is optional.
-- ---------------------------------------------------------------------
create table if not exists [public.client](https://public.client)_apps (
  id                    uuid primary key default gen_random_uuid(),
  client_id             text not null unique
                        default ('app_' || substr(replace(gen_random_uuid()::text, '-', ''), 1, 20))
                        check (client_id ~ '^app_[a-z0-9]{8,40}$'),
  name                  text not null check (char_length(name) between 1 and 80),
  description           text null check (description is null or char_length(description) <= 500),
  status                text not null default 'active' check (status in ('active', 'disabled')),
  default_duration_days integer not null default 30  check (default_duration_days between 1 and 3650),
  default_max_devices   integer not null default 1   check (default_max_devices between 1 and 100),
  max_devices_cap       integer not null default 10  check (max_devices_cap between 1 and 100),
  max_duration_days     integer not null default 3650 check (max_duration_days between 1 and 36500),
  allow_lifetime        boolean not null default false,
  secret_hash           text null check (secret_hash is null or secret_hash ~ '^[0-9a-f]{64}$'),
  secret_rotated_at     timestamptz null,
  metadata              jsonb not null default '{}'::jsonb
                        check (jsonb_typeof(metadata) = 'object' and pg_column_size(metadata) <= 4096),
  created_at            timestamptz not null default now(),
  updated_at            timestamptz not null default now(),
  constraint client_apps_defaults_within_caps
    check (default_max_devices <= max_devices_cap and default_duration_days <= max_duration_days)
);

-- ---------------------------------------------------------------------
-- licenses: plaintext keys are NEVER stored — only HMAC-SHA256 (hex)
-- ---------------------------------------------------------------------
create table if not exists [public.licenses](https://public.licenses) (
  id                uuid primary key default gen_random_uuid(),
  app_id            uuid not null references [public.client](https://public.client)_apps(id) on delete restrict,
  key_hash          text not null unique check (key_hash ~ '^[0-9a-f]{64}$'),
  key_hint          text not null check (char_length(key_hint) between 1 and 16),
  label             text not null check (char_length(label) between 1 and 120),
  status            text not null default 'active' check (status in ('active', 'suspended', 'revoked')),
  status_reason     text null check (status_reason is null or char_length(status_reason) <= 300),
  status_changed_at timestamptz not null default now(),
  max_devices       integer not null default 1 check (max_devices between 1 and 100),
  expires_at        timestamptz null,             -- null = lifetime (only if app allows it)
  metadata          jsonb not null default '{}'::jsonb
                    check (jsonb_typeof(metadata) = 'object' and pg_column_size(metadata) <= 4096),
  created_by        uuid null references [auth.users](https://auth.users)(id) on delete set null,
  created_at        timestamptz not null default now(),
  updated_at        timestamptz not null default now(),
  last_activated_at timestamptz null,
  last_verified_at  timestamptz null
);

create index if not exists licenses_app_id_idx     on [public.licenses](https://public.licenses) (app_id);
create index if not exists licenses_status_idx     on [public.licenses](https://public.licenses) (status);
create index if not exists licenses_created_at_idx on [public.licenses](https://public.licenses) (created_at desc);
create index if not exists licenses_expires_at_idx on [public.licenses](https://public.licenses) (expires_at);

-- ---------------------------------------------------------------------
-- devices: server-issued device tokens (hashed). Fingerprint is optional,
-- hashed, and NOT treated as proof of identity.
-- ---------------------------------------------------------------------
create table if not exists [public.devices](https://public.devices) (
  id               uuid primary key default gen_random_uuid(),
  license_id       uuid not null references [public.licenses](https://public.licenses)(id) on delete cascade,
  token_hash       text not null unique check (token_hash ~ '^[0-9a-f]{64}$'),
  fingerprint_hash text null check (fingerprint_hash is null or fingerprint_hash ~ '^[0-9a-f]{64}$'),
  label            text null check (label is null or char_length(label) <= 80),
  status           text not null default 'active' check (status in ('active', 'removed')),
  created_at       timestamptz not null default now(),
  last_seen_at     timestamptz not null default now(),
  removed_at       timestamptz null,
  removed_reason   text null
                   check (removed_reason is null or removed_reason in ('admin', 'client', 'license_reset'))
);

create index if not exists devices_license_active_idx
  on [public.devices](https://public.devices) (license_id) where status = 'active';
create unique index if not exists devices_license_fp_active_uidx
  on [public.devices](https://public.devices) (license_id, fingerprint_hash)
  where status = 'active' and fingerprint_hash is not null;

-- ---------------------------------------------------------------------
-- audit_events: append-only security log (no keys/tokens/passwords)
-- ---------------------------------------------------------------------
create table if not exists [public.audit](https://public.audit)_events (
  id          bigint generated always as identity primary key,
  event_type  text not null check (char_length(event_type) <= 64 and event_type ~ '^[a-z_]+(\.[a-z_]+)*$'),
  actor_type  text not null check (actor_type in ('admin', 'client', 'system', 'anonymous')),
  actor_id    uuid null,
  target_type text null check (target_type is null or target_type in ('license', 'device', 'app', 'admin')),
  target_id   uuid null,
  request_id  text null check (request_id is null or char_length(request_id) <= 64),
  ip_hash     text null check (ip_hash is null or ip_hash ~ '^[0-9a-f]{16,64}$'),
  metadata    jsonb not null default '{}'::jsonb
              check (jsonb_typeof(metadata) = 'object' and pg_column_size(metadata) <= 4096),
  created_at  timestamptz not null default now()
);

create index if not exists audit_created_at_idx on [public.audit](https://public.audit)_events (created_at desc);
create index if not exists audit_type_idx       on [public.audit](https://public.audit)_events (event_type, created_at desc);
create index if not exists audit_target_idx     on [public.audit](https://public.audit)_events (target_id) where target_id is not null;
create index if not exists audit_actor_idx      on [public.audit](https://public.audit)_events (actor_id)  where actor_id is not null;

-- ---------------------------------------------------------------------
-- Triggers
-- ---------------------------------------------------------------------
create or replace function [public.nexus](https://public.nexus)_license_guard()
returns trigger
language plpgsql
set search_path = ''
as $$
begin
  if [new.key](https://new.key)_hash is distinct from [old.key](https://old.key)_hash then
    raise exception 'key_hash is immutable' using errcode = 'P0001';
  end if;
  if [new.app](https://new.app)_id is distinct from [old.app](https://old.app)_id then
    raise exception 'app_id is immutable' using errcode = 'P0001';
  end if;
  if [old.status](https://old.status) = 'revoked' and [new.status](https://new.status) <> 'revoked' then
    raise exception 'revoked licenses cannot be reactivated' using errcode = 'P0001';
  end if;
  if [new.status](https://new.status) is distinct from [old.status](https://old.status) then
    [new.status](https://new.status)_changed_at := now();
  end if;
  return new;
end;
$$;

create or replace function [public.nexus](https://public.nexus)_audit_immutable()
returns trigger
language plpgsql
set search_path = ''
as $$
begin
  raise exception 'audit_events is append-only' using errcode = 'P0001';
end;
$$;

create or replace trigger client_apps_updated_at
  before update on [public.client](https://public.client)_apps
  for each row execute function [public.nexus](https://public.nexus)_set_updated_at();

create or replace trigger licenses_updated_at
  before update on [public.licenses](https://public.licenses)
  for each row execute function [public.nexus](https://public.nexus)_set_updated_at();

create or replace trigger licenses_guard
  before update on [public.licenses](https://public.licenses)
  for each row execute function [public.nexus](https://public.nexus)_license_guard();

create or replace trigger audit_events_no_update
  before update on [public.audit](https://public.audit)_events
  for each row execute function [public.nexus](https://public.nexus)_audit_immutable();

-- ---------------------------------------------------------------------
-- ATOMIC ACTIVATION — row lock (FOR UPDATE) serializes concurrent
-- activations on the same license, so device limit cannot be exceeded.
-- ---------------------------------------------------------------------
create or replace function [public.nexus](https://public.nexus)_activate_device(
  p_client_id        text,
  p_key_hash         text,
  p_token_hash       text,
  p_fingerprint_hash text default null,
  p_label            text default null
)
returns table (
  r_result       text,
  r_license_id   uuid,
  r_device_id    uuid,
  r_expires_at   timestamptz,
  r_devices_used integer,
  r_max_devices  integer
)
language plpgsql
security invoker
set search_path = ''
as $$
declare
  v_app    [public.client](https://public.client)_apps%rowtype;
  v_lic    [public.licenses](https://public.licenses)%rowtype;
  v_dev_id uuid;
  v_used   integer;
begin
  if p_key_hash !~ '^[0-9a-f]{64}$' or p_token_hash !~ '^[0-9a-f]{64}$'
     or (p_fingerprint_hash is not null and p_fingerprint_hash !~ '^[0-9a-f]{64}$') then
    return query select 'invalid'::text, null::uuid, null::uuid, null::timestamptz, null::integer, null::integer;
    return;
  end if;

  select * into v_app from [public.client](https://public.client)_apps a where [a.client](https://a.client)_id = p_client_id;
  if not found or [v_app.status](https://v_app.status) <> 'active' then
    return query select 'invalid'::text, null::uuid, null::uuid, null::timestamptz, null::integer, null::integer;
    return;
  end if;

  select * into v_lic
    from [public.licenses](https://public.licenses) l
   where [l.key](https://l.key)_hash = p_key_hash and [l.app](https://l.app)_id = [v_app.id](https://v_app.id)
   for update;

  if not found then
    return query select 'invalid'::text, null::uuid, null::uuid, null::timestamptz, null::integer, null::integer;
    return;
  end if;

  if [v_lic.status](https://v_lic.status) <> 'active' then
    return query select [v_lic.status](https://v_lic.status)::text, [v_lic.id](https://v_lic.id), null::uuid, [v_lic.expires](https://v_lic.expires)_at, null::integer, [v_lic.max](https://v_lic.max)_devices;
    return;
  end if;

  if [v_lic.expires](https://v_lic.expires)_at is not null and [v_lic.expires](https://v_lic.expires)_at <= now() then
    return query select 'expired'::text, [v_lic.id](https://v_lic.id), null::uuid, [v_lic.expires](https://v_lic.expires)_at, null::integer, [v_lic.max](https://v_lic.max)_devices;
    return;
  end if;

  -- Same device re-activating: rotate its token instead of using a new slot
  if p_fingerprint_hash is not null then
    update [public.devices](https://public.devices) d
       set token_hash   = p_token_hash,
           last_seen_at = now(),
           label        = coalesce(p_label, [d.labe](https://d.labe)l)
     where [d.license](https://d.license)_id = [v_lic.id](https://v_lic.id)
       and [d.fingerprint](https://d.fingerprint)_hash = p_fingerprint_hash
       and [d.status](https://d.status) = 'active'
    returning [d.id](https://d.id) into v_dev_id;
  end if;

  if v_dev_id is null then
    select count(*)::integer into v_used
      from [public.devices](https://public.devices) d
     where [d.license](https://d.license)_id = [v_lic.id](https://v_lic.id) and [d.status](https://d.status) = 'active';

    if v_used >= [v_lic.max](https://v_lic.max)_devices then
      return query select 'device_limit'::text, [v_lic.id](https://v_lic.id), null::uuid, [v_lic.expires](https://v_lic.expires)_at, v_used, [v_lic.max](https://v_lic.max)_devices;
      return;
    end if;

    insert into [public.devices](https://public.devices) (license_id, token_hash, fingerprint_hash, label)
    values ([v_lic.id](https://v_lic.id), p_token_hash, p_fingerprint_hash, p_label)
    returning id into v_dev_id;
  end if;

  update [public.licenses](https://public.licenses) l set last_activated_at = now() where [l.id](https://l.id) = [v_lic.id](https://v_lic.id);

  select count(*)::integer into v_used
    from [public.devices](https://public.devices) d
   where [d.license](https://d.license)_id = [v_lic.id](https://v_lic.id) and [d.status](https://d.status) = 'active';

  return query select 'ok'::text, [v_lic.id](https://v_lic.id), v_dev_id, [v_lic.expires](https://v_lic.expires)_at, v_used, [v_lic.max](https://v_lic.max)_devices;
end;
$$;

-- ---------------------------------------------------------------------
-- VERIFY — checks device token + license + app status on every call
-- ---------------------------------------------------------------------
create or replace function [public.nexus](https://public.nexus)_verify_device(
  p_client_id  text,
  p_token_hash text
)
returns table (
  r_result     text,
  r_license_id uuid,
  r_device_id  uuid,
  r_expires_at timestamptz
)
language plpgsql
security invoker
set search_path = ''
as $$
declare
  v record;
begin
  if p_token_hash !~ '^[0-9a-f]{64}$' then
    return query select 'invalid'::text, null::uuid, null::uuid, null::timestamptz;
    return;
  end if;

  select [d.id](https://d.id)          as device_id,
         [d.status](https://d.status)      as device_status,
         [d.last](https://d.last)_seen_at,
         [l.id](https://l.id)          as license_id,
         [l.status](https://l.status)      as license_status,
         [l.expires](https://l.expires)_at,
         [a.status](https://a.status)      as app_status,
         [a.client](https://a.client)_id
    into v
    from [public.devices](https://public.devices) d
    join [public.licenses](https://public.licenses) l    on [l.id](https://l.id) = [d.license](https://d.license)_id
    join [public.client](https://public.client)_apps a on [a.id](https://a.id) = [l.app](https://l.app)_id
   where [d.token](https://d.token)_hash = p_token_hash;

  if not found or [v.client](https://v.client)_id <> p_client_id or [v.app](https://v.app)_status <> 'active' then
    return query select 'invalid'::text, null::uuid, null::uuid, null::timestamptz;
    return;
  end if;

  if [v.device](https://v.device)_status <> 'active' then
    return query select 'device_removed'::text, [v.license](https://v.license)_id, [v.device](https://v.device)_id, [v.expires](https://v.expires)_at;
    return;
  end if;

  if [v.license](https://v.license)_status <> 'active' then
    return query select [v.license](https://v.license)_status::text, [v.license](https://v.license)_id, [v.device](https://v.device)_id, [v.expires](https://v.expires)_at;
    return;
  end if;

  if [v.expires](https://v.expires)_at is not null and [v.expires](https://v.expires)_at <= now() then
    return query select 'expired'::text, [v.license](https://v.license)_id, [v.device](https://v.device)_id, [v.expires](https://v.expires)_at;
    return;
  end if;

  -- Throttled write: update last_seen at most every 5 minutes
  if [v.last](https://v.last)_seen_at < now() - interval '5 minutes' then
    update [public.devices](https://public.devices)  d set last_seen_at = now()     where [d.id](https://d.id) = [v.device](https://v.device)_id;
    update [public.licenses](https://public.licenses) l set last_verified_at = now() where [l.id](https://l.id) = [v.license](https://v.license)_id;
  end if;

  return query select 'ok'::text, [v.license](https://v.license)_id, [v.device](https://v.device)_id, [v.expires](https://v.expires)_at;
end;
$$;

-- ---------------------------------------------------------------------
-- DEACTIVATE — client frees its own device slot
-- ---------------------------------------------------------------------
create or replace function [public.nexus](https://public.nexus)_deactivate_device(
  p_client_id  text,
  p_token_hash text
)
returns table (r_result text, r_license_id uuid, r_device_id uuid)
language plpgsql
security invoker
set search_path = ''
as $$
declare
  v_dev_id uuid;
  v_lic_id uuid;
begin
  if p_token_hash !~ '^[0-9a-f]{64}$' then
    return query select 'invalid'::text, null::uuid, null::uuid;
    return;
  end if;

  update [public.devices](https://public.devices) d
     set status = 'removed', removed_at = now(), removed_reason = 'client'
    from [public.licenses](https://public.licenses) l, [public.client](https://public.client)_apps a
   where [d.token](https://d.token)_hash = p_token_hash
     and [d.status](https://d.status) = 'active'
     and [l.id](https://l.id) = [d.license](https://d.license)_id
     and [a.id](https://a.id) = [l.app](https://l.app)_id
     and [a.client](https://a.client)_id = p_client_id
  returning [d.id](https://d.id), [d.license](https://d.license)_id into v_dev_id, v_lic_id;

  if v_dev_id is null then
    return query select 'invalid'::text, null::uuid, null::uuid;
    return;
  end if;

  return query select 'ok'::text, v_lic_id, v_dev_id;
end;
$$;

-- ---------------------------------------------------------------------
-- Dashboard stats
-- ---------------------------------------------------------------------
create or replace function [public.nexus](https://public.nexus)_admin_stats()
returns table (
  r_total          bigint,
  r_active         bigint,
  r_suspended      bigint,
  r_revoked        bigint,
  r_expired        bigint,
  r_active_devices bigint,
  r_apps           bigint
)
language sql
stable
security invoker
set search_path = ''
as $$
  select
    (select count(*) from [public.license](https://public.license)s),
    (select count(*) from [public.licenses](https://public.licenses) where status = 'active' and (expires_at is null or expires_at > now())),
    (select count(*) from [public.licenses](https://public.licenses) where status = 'suspended'),
    (select count(*) from [public.licenses](https://public.licenses) where status = 'revoked'),
    (select count(*) from [public.licenses](https://public.licenses) where status = 'active' and expires_at <= now()),
    (select count(*) from [public.devices](https://public.devices)  where status = 'active'),
    (select count(*) from [public.client](https://public.client)_apps);
$$;

-- ---------------------------------------------------------------------
-- Retention (run manually or via pg_cron). Minimum 30 days.
-- ---------------------------------------------------------------------
create or replace function [public.nexus](https://public.nexus)_purge_old_records(
  p_audit_days  integer default 365,
  p_device_days integer default 180
)
returns table (r_audit_deleted bigint, r_devices_deleted bigint)
language plpgsql
security invoker
set search_path = ''
as $$
declare
  v_a bigint;
  v_d bigint;
begin
  if p_audit_days < 30 or p_device_days < 30 then
    raise exception 'retention must be at least 30 days' using errcode = 'P0001';
  end if;

  delete from [public.audit](https://public.audit)_events
   where created_at < now() - make_interval(days => p_audit_days);
  get diagnostics v_a = row_count;

  delete from [public.devices](https://public.devices)
   where status = 'removed'
     and removed_at < now() - make_interval(days => p_device_days);
  get diagnostics v_d = row_count;

  return query select v_a, v_d;
end;
$$;

-- =====================================================================
-- ROW LEVEL SECURITY — deny by default.
-- No policies are created on purpose: anon & authenticated get NOTHING.
-- Only the server (service_role via secret key) can access these tables.
-- =====================================================================
alter table [public.admin](https://public.admin)_users  enable row level security;
alter table [public.client](https://public.client)_apps  enable row level security;
alter table [public.licenses](https://public.licenses)     enable row level security;
alter table [public.devices](https://public.devices)      enable row level security;
alter table [public.audit](https://public.audit)_events enable row level security;

-- Second layer: remove table privileges from browser-facing roles
revoke all on table [public.admin](https://public.admin)_users, [public.client](https://public.client)_apps, [public.licenses](https://public.licenses),
                    [public.devices](https://public.devices), [public.audit](https://public.audit)_events
  from anon, authenticated;

grant select, insert, update, delete on table
  [public.admin](https://public.admin)_users, [public.client](https://public.client)_apps, [public.licenses](https://public.licenses),
  [public.devices](https://public.devices), [public.audit](https://public.audit)_events
  to service_role;

grant usage, select on sequence [public.audit](https://public.audit)_events_id_seq to service_role;

-- Functions: nobody except service_role may execute
revoke execute on function [public.nexus](https://public.nexus)_activate_device(text, text, text, text, text) from public, anon, authenticated;
revoke execute on function [public.nexus](https://public.nexus)_verify_device(text, text)                     from public, anon, authenticated;
revoke execute on function [public.nexus](https://public.nexus)_deactivate_device(text, text)                 from public, anon, authenticated;
revoke execute on function [public.nexus](https://public.nexus)_admin_stats()                                 from public, anon, authenticated;
revoke execute on function [public.nexus](https://public.nexus)_purge_old_records(integer, integer)           from public, anon, authenticated;
revoke execute on function [public.nexus](https://public.nexus)_set_updated_at()                              from public, anon, authenticated;
revoke execute on function [public.nexus](https://public.nexus)_license_guard()                               from public, anon, authenticated;
revoke execute on function [public.nexus](https://public.nexus)_audit_immutable()                             from public, anon, authenticated;

grant execute on function [public.nexus](https://public.nexus)_activate_device(text, text, text, text, text) to service_role;
grant execute on function [public.nexus](https://public.nexus)_verify_device(text, text)                     to service_role;
grant execute on function [public.nexus](https://public.nexus)_deactivate_device(text, text)                 to service_role;
grant execute on function [public.nexus](https://public.nexus)_admin_stats()                                 to service_role;
grant execute on function [public.nexus](https://public.nexus)_purge_old_records(integer, integer)           to service_role;

-- ---------------------------------------------------------------------
-- Seed: one default app (only if none exist)
-- ---------------------------------------------------------------------
insert into [public.client](https://public.client)_apps (name, description)
select 'Default Website', 'Created by migration 001'
where not exists (select 1 from [public.client](https://public.client)_apps);

commit;